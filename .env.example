# Copia este archivo a ".env" (cp .env.example .env) y cambia los valores.
# El archivo ".env" NO se sube a GitHub (esta en .gitignore).
#
# IMPORTANTE:
#  - No uses el simbolo "$" en las claves (docker compose lo interpreta).
#  - MSSQL_SA_PASSWORD: minimo 8 caracteres con mayuscula, minuscula, numero y simbolo.

# ---- SQL Server ----
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_123
DB_NAME=TecnoStockDB
# Puerto con el que TU PC ve a SQL Server (por si el 1433 esta ocupado en Windows)
DB_PORT_HOST=1433

# ---- Backend ----
# Genera una clave larga y aleatoria:  openssl rand -hex 32
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# Usuario inicial (el backend lo crea al arrancar si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin_12345
ADMIN_NOMBRE=Administrador

# ---- Puertos publicados en tu PC ----
FRONTEND_PORT=8080
BACKEND_PORT=8000
